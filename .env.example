# =============================================================================
# SDS Nexus Platform - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.

# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------
APP_NAME="SDS Nexus Platform"
APP_VERSION="1.0.0"
APP_ENV="development"           # development | staging | production
APP_HOST="0.0.0.0"
APP_PORT=8000
APP_DEBUG=false
APP_SECRET_KEY="change-this-to-a-strong-random-secret-key-min-32-chars"
APP_ALLOWED_HOSTS="localhost,127.0.0.1"
APP_CORS_ORIGINS="http://localhost:3000,http://localhost:8080"

# -----------------------------------------------------------------------------
# DATABASE (PostgreSQL)
# -----------------------------------------------------------------------------
DB_HOST="localhost"
DB_PORT=5432
DB_NAME="sds_nexus"
DB_USER="sds_nexus_user"
DB_PASSWORD="change-this-strong-password"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600
DB_ECHO_SQL=false

# Constructed from above (set manually if needed)
# DATABASE_URL="postgresql://sds_nexus_user:password@localhost:5432/sds_nexus"

# -----------------------------------------------------------------------------
# PRIMARY CEPH CLUSTER
# -----------------------------------------------------------------------------
CEPH_CLUSTER_NAME="prod-cluster-01"
CEPH_CLUSTER_DISPLAY_NAME="Production Ceph Cluster"
CEPH_MONITOR_HOST="10.0.0.1"
CEPH_MONITOR_PORT=6789
CEPH_ADMIN_NODE="ceph-admin.internal"
CEPH_SSH_USER="cephadmin"
CEPH_SSH_KEY_PATH="/etc/sds-nexus/keys/ceph_admin_key"
CEPH_SSH_PORT=22
CEPH_SSH_TIMEOUT=30
CEPH_SSH_RETRY_ATTEMPTS=3
CEPH_SSH_RETRY_DELAY=5

# -----------------------------------------------------------------------------
# RADOSGW (S3 API)
# -----------------------------------------------------------------------------
RGW_ENDPOINT="http://rgw.internal:7480"
RGW_ACCESS_KEY="your-rgw-access-key"
RGW_SECRET_KEY="your-rgw-secret-key"
RGW_ADMIN_ENDPOINT="http://rgw.internal:7480/admin"
RGW_ADMIN_ACCESS_KEY="your-rgw-admin-access-key"
RGW_ADMIN_SECRET_KEY="your-rgw-admin-secret-key"
RGW_VERIFY_SSL=false
RGW_TIMEOUT=30

# -----------------------------------------------------------------------------
# EMAIL (SMTP)
# -----------------------------------------------------------------------------
SMTP_HOST="smtp.internal"
SMTP_PORT=587
SMTP_USER="sds-nexus@company.com"
SMTP_PASSWORD="change-this-email-password"
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=30
SMTP_FROM_ADDRESS="sds-nexus@company.com"
SMTP_FROM_NAME="SDS Nexus Platform"

# Email distribution lists
EMAIL_OPS_TEAM="ops-team@company.com,storage-ops@company.com"
EMAIL_MANAGEMENT="management@company.com"
EMAIL_ALERTS="storage-alerts@company.com"

# -----------------------------------------------------------------------------
# CHARGEBACK
# -----------------------------------------------------------------------------
CHARGEBACK_CURRENCY_PRIMARY="GBP"
CHARGEBACK_CURRENCY_SECONDARY="USD"
CHARGEBACK_GBP_PER_GB_MONTH="0.05"
CHARGEBACK_USD_PER_GB_MONTH="0.06"
CHARGEBACK_GBP_USD_RATE="1.27"
CHARGEBACK_BILLING_DAY=1              # Day of month for billing cycle
CHARGEBACK_INCLUDE_VAT=true
CHARGEBACK_VAT_RATE="0.20"

# -----------------------------------------------------------------------------
# MONITORING INTERVALS (seconds)
# -----------------------------------------------------------------------------
MONITOR_CLUSTER_HEALTH_INTERVAL=300      # 5 minutes
MONITOR_NODE_INTERVAL=300                # 5 minutes
MONITOR_OBJECT_STORAGE_INTERVAL=3600     # 1 hour
MONITOR_CAPACITY_INTERVAL=3600           # 1 hour

# Alert thresholds
ALERT_OSD_DOWN_THRESHOLD=1               # Alert if >= N OSDs down
ALERT_PG_DEGRADED_THRESHOLD=100          # Alert if >= N PGs degraded
ALERT_CAPACITY_WARNING_PERCENT=75        # Warn at 75% capacity
ALERT_CAPACITY_CRITICAL_PERCENT=85       # Critical at 85% capacity
ALERT_CLUSTER_UNHEALTHY=true

# -----------------------------------------------------------------------------
# REPORTING
# -----------------------------------------------------------------------------
REPORT_OUTPUT_PATH="/var/sds-nexus/reports"
REPORT_RETENTION_DAYS=365
REPORT_DAILY_EMAIL_TIME="07:00"          # 24h format, local time
REPORT_6H_SCHEDULE="0 */6 * * *"        # Cron expression
REPORT_MONTHLY_DAY=1                     # Day of month for monthly report

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
LOG_LEVEL="INFO"                         # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT="json"                        # json | text
LOG_OUTPUT_PATH="/var/log/sds-nexus"
LOG_ROTATION="100 MB"
LOG_RETENTION="30 days"
LOG_BACKTRACE=true
LOG_DIAGNOSE=false                       # Set true only in development

# -----------------------------------------------------------------------------
# SECURITY
# -----------------------------------------------------------------------------
JWT_SECRET_KEY="change-this-jwt-secret-key-min-32-chars"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# API Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# -----------------------------------------------------------------------------
# REDIS (Optional - for caching/task queue)
# -----------------------------------------------------------------------------
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0

# -----------------------------------------------------------------------------
# PATHS
# -----------------------------------------------------------------------------
TEMP_DIR="/tmp/sds-nexus"
DATA_DIR="/var/sds-nexus/data"
BACKUP_DIR="/var/sds-nexus/backups"
